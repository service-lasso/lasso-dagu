{
  "id": "dagu",
  "name": "Dagu",
  "description": "Managed Dagu workflow runner with Web UI/API packaged for Service Lasso.",
  "enabled": true,
  "version": "0.1.0",
  "logoutput": true,
  "icon": [
    {
      "provider": "lucide",
      "name": "workflow"
    }
  ],
  "servicetype": 50,
  "servicelocation": 10,
  "logo": [],
  "endpoints": [
    {
      "id": "http",
      "kind": "network",
      "label": "Dagu HTTP UI/API",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 18088,
        "strategy": "fixed"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "ui",
      "kind": "url",
      "label": "Dagu UI/API",
      "target": "http",
      "url": "http://${endpoint.http.bind}:${endpoint.http.port}/",
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "mcp",
      "kind": "url",
      "label": "Dagu MCP",
      "target": "http",
      "url": "http://${endpoint.http.bind}:${endpoint.http.port}/mcp",
      "exposure": "local",
      "required": false
    }
  ],
  "logs": {
    "default": {
      "path": "logs/dagu.log"
    }
  },
  "meta": {
    "developers": [
      {
        "name": "Service Lasso contributors"
      }
    ],
    "license": "GPL-3.0",
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-dagu.git"
    },
    "websiteUrl": "https://dagu.sh/",
    "documentationUrl": "https://github.com/service-lasso/lasso-dagu/blob/main/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-dagu/issues",
    "support": {
      "issuesUrl": "https://github.com/service-lasso/lasso-dagu/issues"
    },
    "links": {
      "repository": "https://github.com/service-lasso/lasso-dagu",
      "upstream": "https://github.com/dagucloud/dagu",
      "documentation": "https://docs.dagu.cloud/",
      "issues": "https://github.com/service-lasso/lasso-dagu/issues"
    },
    "tags": [
      "service-lasso",
      "dagu",
      "workflow-runner",
      "automation"
    ]
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-dagu",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "dagu-service-win32.zip",
        "archiveType": "zip",
        "command": "./runtime/dagu-service.ps1",
        "args": []
      },
      "darwin": {
        "assetName": "dagu-service-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/dagu-service.sh",
        "args": []
      },
      "linux": {
        "assetName": "dagu-service-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./runtime/dagu-service.sh",
        "args": []
      },
      "default": {
        "assetName": "dagu-service-win32.zip",
        "archiveType": "zip",
        "command": "./runtime/dagu-service.ps1",
        "args": []
      }
    }
  },
  "actions": {
    "install": {
      "description": "Acquire or unpack the packaged Dagu runtime artifact.",
      "mode": "converge-install",
      "idempotent": true
    },
    "config": {
      "description": "Materialize deployment-local Dagu config, workflow, data, and log directories.",
      "mode": "converge-config",
      "idempotent": true
    },
    "update": {
      "description": "Apply a newer Dagu service release artifact and reconcile update-time changes before restart.",
      "mode": "converge-update",
      "idempotent": true
    },
    "start": {
      "description": "Start Dagu HTTP server, scheduler, coordinator, and local worker.",
      "mode": "runtime-start",
      "idempotent": true
    },
    "stop": {
      "description": "Stop Dagu gracefully.",
      "mode": "runtime-stop",
      "idempotent": true
    },
    "restart": {
      "description": "Restart Dagu after config or update changes.",
      "mode": "runtime-restart",
      "idempotent": false
    },
    "rollback": {
      "description": "Restore the previously deployed artifact if an update fails validation.",
      "mode": "state-rollback",
      "idempotent": false
    }
  },
  "execconfig": {
    "serviceorder": 160,
    "serviceport": 18088,
    "execcwd": ".",
    "executable": "dagu-service",
    "env": {
      "DAGU_HOST": "127.0.0.1",
      "DAGU_PORT": "${endpoint.http.port}",
      "DAGU_HOME": "${SERVICE_ROOT}/data",
      "DAGU_WORKFLOWS_DIR": "${SERVICE_ROOT}/workflows",
      "DAGU_LOG_DIR": "${SERVICE_ROOT}/logs",
      "DAGU_CONFIG": "${SERVICE_ROOT}/config/dagu.yaml"
    },
    "globalenv": {
      "DAGU_URL": "${endpoint.ui.url}",
      "DAGU_MCP_URL": "${endpoint.mcp.url}",
      "DAGU_WORKFLOWS_DIR": "${SERVICE_ROOT}/workflows"
    },
    "depend_on": [
      "@python"
    ],
    "healthchecks": [
      {
        "id": "ui",
        "type": "http",
        "url": "${endpoint.ui.url}",
        "expected_status": 200,
        "retries": 80,
        "interval": 500
      }
    ]
  }
}
